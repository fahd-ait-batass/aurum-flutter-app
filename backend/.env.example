AURUM_BACKEND_ENV=production
AURUM_BACKEND_HOST=0.0.0.0
PORT=8080
AURUM_PUBLIC_BASE_URL=https://your-api.example.com
AURUM_ALLOWED_ORIGINS=https://your-app.example.com
AURUM_BACKEND_DATA_DIR=/app/data

# Railway notes:
# - Railway can also provide RAILWAY_PUBLIC_DOMAIN automatically.
# - Railway volumes can expose RAILWAY_VOLUME_MOUNT_PATH automatically.
# - Keep AURUM_BACKEND_DATA_DIR=/app/data if you mount a volume there.
